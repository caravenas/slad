{
  "name": "@slad/cli",
  "version": "0.1.0",
  "description": "SLAD OS CLI — explore intent, generate Snapshots, orchestrate agents across multiple LLM providers.",
  "type": "module",
  "bin": {
    "slad": "./bin/slad.js"
  },
  "main": "dist/cli.js",
  "files": [
    "bin",
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "pnpm --filter @slad/cache --filter @slad/audit-log --filter @slad/context-budget --filter @slad/model-providers --filter @slad/hitl --filter @slad/harness --filter @slad/tools --filter @slad/pipeline build && tsc",
    "bundle": "tsup",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "pnpm --filter @slad/cache --filter @slad/audit-log --filter @slad/context-budget --filter @slad/model-providers --filter @slad/hitl --filter @slad/harness --filter @slad/tools --filter @slad/pipeline build && tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "node --import tsx/esm --test 'src/**/*.test.ts'"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cli",
    "agent",
    "llm",
    "claude",
    "openai",
    "gemini",
    "slad-os"
  ],
  "author": "Christopher Aravena",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.4.2",
    "@slad/agent": "workspace:*",
    "@slad/audit-log": "workspace:*",
    "@slad/cache": "workspace:*",
    "@slad/context-budget": "workspace:*",
    "@slad/harness": "workspace:*",
    "@slad/hitl": "workspace:*",
    "@slad/model-providers": "workspace:*",
    "@slad/pipeline": "workspace:*",
    "@slad/shared": "workspace:*",
    "@slad/tools": "workspace:*",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "kleur": "^4.1.5",
    "ora": "^8.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
