{
  "name": "@slad/cli",
  "version": "0.1.0",
  "description": "SLAD CLI — orchestrate approved plans across local coding-agent CLIs.",
  "type": "module",
  "bin": {
    "slad": "./bin/slad.js"
  },
  "main": "dist/cli.js",
  "files": [
    "bin",
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "bundle": "tsup",
    "dev": "tsx src/dev.ts",
    "start": "node ./bin/slad.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "clean": "rm -rf dist",
    "test": "node --import tsx/esm --test 'src/**/*.test.ts'"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cli",
    "agent",
    "llm",
    "claude",
    "slad-os"
  ],
  "author": "Christopher Aravena",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.4.2",
    "@slad/cache": "workspace:*",
    "@slad/harness": "workspace:*",
    "@slad/hitl": "workspace:*",
    "@slad/model-providers": "workspace:*",
    "@slad/pipeline": "workspace:*",
    "@slad/shared": "workspace:*",
    "@slad/tools": "workspace:*",
    "ajv": "^8.17.1",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "kleur": "^4.1.5",
    "ora": "^8.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
