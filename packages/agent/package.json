{
  "name": "@slad/agent",
  "version": "0.1.0",
  "private": true,
  "description": "High-level Agent SDK for SLAD OS",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc -b",
    "test": "node --import tsx/esm --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@slad/cache": "workspace:*",
    "@slad/harness": "workspace:*",
    "@slad/hitl": "workspace:*",
    "@slad/memory": "workspace:*",
    "@slad/model-providers": "workspace:*",
    "@slad/pipeline": "workspace:*",
    "@slad/shared": "workspace:*",
    "@slad/telemetry": "workspace:*",
    "@slad/tools": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "5.6.3"
  }
}
