{
  "name": "research-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Official SLAD example — a research agent built ONLY on the public SDK API (dogfood / forcing function).",
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc",
    "typecheck": "tsc --noEmit",
