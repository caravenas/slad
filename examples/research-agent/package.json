    "@slad/pipeline": "workspace:*",
    "@slad/tools": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "5.6.3"
  }
}
